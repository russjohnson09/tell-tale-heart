; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tell Tale Heart"
run/main_scene="uid://bdfu8gjh3gjr8"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="uid://c08t4gvohrdvp"
config/icon="uid://c08t4gvohrdvp"

[audio]

buses/default_bus_layout="uid://b8wr0hwoqop4v"
driver/enable_input=true

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[editor_plugins]

enabled=PackedStringArray("res://addons/direct_audio_and_wav_24bits/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
